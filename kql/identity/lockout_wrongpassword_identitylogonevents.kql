// Identify lockout / failed logon patterns (WrongPassword / UnknownUser) for a target identifier
// Replace <IDENTIFIER> with a user/device/IP fragment relevant to your hunt.
IdentityLogonEvents
| search "<IDENTIFIER>"
| where FailureReason in ("WrongPassword","UnknownUser")
| summarize Count=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by DeviceName, AccountName, FailureReason
| order by Count desc
